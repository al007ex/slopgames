{
  "name": "pixel-brawl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel Brawl — a 2D pixel-art arena brawler (io-style) inspired by the Brawl Stars beta",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env PORT=8080 tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
